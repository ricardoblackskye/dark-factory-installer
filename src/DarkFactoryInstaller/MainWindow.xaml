<Window x:Class="DarkFactoryInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dark Factory Installer" Height="740" Width="880">
    <Grid Margin="24">
        <StackPanel Orientation="Vertical" VerticalAlignment="Top">
            <TextBlock FontSize="22" FontWeight="Bold" Text="Dark Factory Installer" />
            <TextBlock Margin="0,8,0,0" FontSize="12" Foreground="#666666"
                       Text="WS2 prerequisite detection (#4) + WS3 binary acquisition (#5) + WS6 NDJSON UI (#8)." />

            <Button x:Name="CheckBtn" Margin="0,16,0,0" Padding="8,4" HorizontalAlignment="Left"
                    Content="Check prerequisites" Click="CheckBtn_Click" />
            <ListBox x:Name="PrereqList" Margin="0,12,0,0" MinHeight="110" />

            <Button x:Name="VerifyBinariesBtn" Margin="0,12,0,0" Padding="8,4" HorizontalAlignment="Left"
                    Content="Verify binaries (manifest)" Click="VerifyBinariesBtn_Click" />
            <ListBox x:Name="BinaryList" Margin="0,12,0,0" MinHeight="110" />

            <Separator Margin="0,16,0,0" />
            <TextBlock FontSize="16" FontWeight="Bold" Text="Provision" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock VerticalAlignment="Center" Text="Repo:" />
                <TextBox x:Name="RepoBox" Width="260" Margin="6,0,12,0" Text="ricardoblackskye/agent-eve" />
                <TextBlock VerticalAlignment="Center" Text="Issue:" />
                <TextBox x:Name="IssueBox" Width="80" Margin="6,0,12,0" Text="1" />
                <Button x:Name="ProvisionBtn" Padding="8,4" Content="Provision" Click="ProvisionBtn_Click" IsEnabled="False" />
            </StackPanel>

            <TextBlock x:Name="BannerTextBlock" Margin="0,12,0,0" FontWeight="Bold" Visibility="Collapsed" TextWrapping="Wrap" />
            <ItemsControl x:Name="StepList" Margin="0,12,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                            <TextBlock Width="80" Text="{Binding Step}" FontWeight="SemiBold" />
                            <TextBlock Width="70" Text="{Binding Phase}" />
                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Margin="0,12,0,0" FontWeight="Bold" Text="Log (stderr prose)" />
            <TextBox x:Name="LogTextBox" Margin="0,6,0,0" Height="120" IsReadOnly="True"
                     VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" AcceptsReturn="True" />
        </StackPanel>
    </Grid>
</Window>